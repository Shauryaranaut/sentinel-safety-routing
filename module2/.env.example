# Sentinel core settings
ORS_API_KEY=your_ors_api_key_here
BACKEND_URL=http://localhost:8000
FRONTEND_BASE_URL=https://your-public-app-host
# Used as a fallback when the SOS request does not include the live page origin.
INCIDENT_ROUTE_RADIUS_METERS=500
CRITICAL_SAFETY_THRESHOLD=60
MIN_SAFETY_IMPROVEMENT=15
MAX_EXTRA_TRAVEL_MINUTES=10
DEMO_MODE=true
POLLING_INTERVAL_SECONDS=15
TEMPORAL_DECAY_MINUTES=60
SIM_SPEED=2

# Safety assistant — local Ollama (no API key)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
MOCK_MODE=false
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=300
# Optional if Ollama is not on the default port
# LLM_BASE_URL=http://127.0.0.1:11434/v1

# Cloud providers (leave unused when LLM_PROVIDER=ollama)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.1-8b-instant
# GROQ_API_KEY=your_groq_api_key_here
# GROK_API_KEY=your_grok_api_key_here
# LLM_API_KEY=your_llm_api_key_here

# SMTP / email settings for SOS guardian alerts
# If these are empty, MOCK_MODE still captures the email body for demo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# OSM Overpass for route lighting / connectivity / safe places
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OVERPASS_TIMEOUT_SECONDS=12
# OVERPASS_QUERY_TIMEOUT_SECONDS=10
# OVERPASS_CORRIDOR_METERS=150

# Optional aliases accepted by the backend too
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USERNAME=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=your-email@gmail.com
  